AAM_DATABASE_URL=postgresql+psycopg://ask_about_me:ask_about_me@localhost:5432/ask_about_me
AAM_TEST_DATABASE_URL=postgresql+psycopg://ask_about_me:ask_about_me@localhost:5433/ask_about_me_test
AAM_TEST_POSTGRES_PORT=5433

# OpenAI server-side credentials. Never expose this file to the portfolio frontend.
AAM_OPENAI_API_KEY=
AAM_EMBEDDING_MODEL=text-embedding-3-small
AAM_EMBEDDING_DIMENSIONS=1536
AAM_EMBEDDING_BATCH_SIZE=64
AAM_GENERATION_MODEL=gpt-5.6-sol
AAM_GENERATION_MAX_OUTPUT_TOKENS=1200
AAM_OPENAI_TIMEOUT_SECONDS=30
AAM_OPENAI_MAX_RETRIES=2
AAM_CHUNK_TARGET_TOKENS=350
AAM_CHUNK_MAX_TOKENS=500
AAM_CHUNK_OVERLAP_TOKENS=50
